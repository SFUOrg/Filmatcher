@page
@model RegisterModel
@{
    ViewData["Title"] = "Регистрация";
}

<div class="auth-layout">
    <div class="auth-card">
        <h1 class="auth-title">Регистрация</h1>
        <p class="auth-subtitle">Создайте аккаунт, чтобы получить доступ к системе.</p>

        <form method="post" class="auth-form">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger auth-validation-summary"></div>

            <div class="auth-field">
                <label asp-for="Input.Email" class="auth-label"></label>
                <input asp-for="Input.Email" class="auth-input" />
                <span asp-validation-for="Input.Email" class="text-danger auth-validation-message"></span>
            </div>

            <div class="auth-field">
                <label asp-for="Input.Password" class="auth-label"></label>
                <input asp-for="Input.Password" class="auth-input" />
                <span asp-validation-for="Input.Password" class="text-danger auth-validation-message"></span>
            </div>

            <div class="auth-field">
                <label asp-for="Input.ConfirmPassword" class="auth-label"></label>
                <input asp-for="Input.ConfirmPassword" class="auth-input" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger auth-validation-message"></span>
            </div>

            <button type="submit" class="btn btn-primary auth-button">
                Зарегистрироваться
            </button>

            <p class="auth-switch">
                Уже есть аккаунт?
                <a asp-page="/Auth/Login">Войти</a>
            </p>
        </form>
    </div>
</div>